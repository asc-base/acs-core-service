# Copy to .env and replace the placeholders before starting the service.

APP_PORT=8000
APP_HOST=0.0.0.0
ENVIRONMENT=development
ALLOW_ORIGIN=http://localhost:3000

# Local PostgreSQL. docker-compose.yml uses DB_* to build its container URL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=acs

# Prisma uses public as the default schema; migrations create the auth schema.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acs?schema=public

# Better Auth secret; generate one with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:8000/api/v1/auth
BETTER_AUTH_SECRET=

# Legacy fallback for BETTER_AUTH_SECRET.
SECRET_JWT=

# Frontend reset page route.
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/auth/reset-password

# Supabase Storage remains in use for non-profile image uploads and is an
# available profile-image provider during rollout.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=
SUPABASE_BUCKET=your-bucket

# Keep Supabase selected for profiles until rollout is complete.
PROFILE_MEDIA_PROVIDER=supabase
NEWS_MEDIA_PROVIDER=rustfs
MEDIA_PROVIDER=rustfs
# Comma-separated storage origins eligible for media migration reads.
MEDIA_SOURCE_ALLOWED_ORIGINS=*
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_REGION=us-east-1
RUSTFS_ACCESS_KEY_ID=profile-media-app-key
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_BUCKET=acs-media
RUSTFS_PUBLIC_BASE_URL=http://localhost:3000/media/acs-media

# Temporary RustFS administrator credentials. Use only for bucket bootstrap.
RUSTFS_BOOTSTRAP_ACCESS_KEY=
RUSTFS_BOOTSTRAP_SECRET_KEY=

# Password reset email. Required in production.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Optional image URLs used in reset password emails.
MAIL_RESET_PASSWORD_LOGO_URL=
MAIL_RESET_PASSWORD_ILLUSTRATION_URL=
