model Prefix {
  id          Int         @id @default(autoincrement()) @map("id")
  sequence    Int         @unique @default(0) @map("sequence")
  nameTh      String      @unique @map("name_th")
  nameEn      String      @map("name_en")
  shortNameTh String      @map("short_name_th")
  shortNameEn String      @map("short_name_en")
  users       User[]

  @@map("prefixes")
}

model NewsFeatures {
  id           Int       @id @default(autoincrement()) @map("id")
  thumbnailURL String    @map("thumbnail_url")
  highlightURL String?   @map("highlight_url")
  newsID       Int       @map("news_id")
  tagID        Int       @map("tag_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    Int       @map("created_by")
  updatedBy    Int       @map("updated_by")
  news         News      @relation(fields: [newsID], references: [id])
  tag          Tag       @relation(fields: [tagID], references: [id])

  @@unique([newsID, tagID])
  @@map("news_features")
}

model Project {
  id              Int             @id @default(autoincrement()) @map("id")
  title           String          @map("title")
  thumbnailURL    String          @map("thumbnail_url")
  thumbnailFocalPointX Float?     @map("thumbnail_focal_point_x")
  thumbnailFocalPointY Float?     @map("thumbnail_focal_point_y")
  assetsURL       String          @map("assets_url")
  techStacks      String          @map("tech_stacks")
  details         String          @map("details")
  githubURL       String          @map("github_url")
  presentationURL String          @map("presentation_url")
  documentURL     String          @map("document_url")
  figmaURL        String?         @map("figma_url")
  youtubeURL      String          @map("youtube_url")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdBy       Int             @map("created_by")
  updatedBy       Int             @map("updated_by")
  projectTags     ProjectTag[]
  projectMembers  ProjectMember[]
  projectCourses  ProjectCourse[]

  @@map("projects")
}

model ProjectTag {
  id        Int       @id @default(autoincrement()) @map("id")
  projectID Int       @map("project_id")
  tagID     Int       @map("tag_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy Int       @map("created_by")
  updatedBy Int       @map("updated_by")

  project Project @relation(fields: [projectID], references: [id])
  tag     Tag     @relation(fields: [tagID], references: [id])

  @@unique([projectID, tagID])
  @@map("project_tags")
}

model ProjectMember {
  id        Int       @id @default(autoincrement()) @map("id")
  projectID Int       @map("project_id")
  userID    Int       @map("user_id")
  roleID    Int       @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy Int       @map("created_by")
  updatedBy Int       @map("updated_by")

  project Project @relation(fields: [projectID], references: [id])
  user    User    @relation(fields: [userID], references: [id])
  role    Role    @relation(fields: [roleID], references: [id])

  @@unique([projectID, userID])
  @@map("project_members")
}

model ProjectCourse {
  id        Int       @id @default(autoincrement()) @map("id")
  projectID Int       @map("project_id")
  courseID    Int       @map("course_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy Int       @map("created_by")
  updatedBy Int       @map("updated_by")

  project Project @relation(fields: [projectID], references: [id])
  course  Course    @relation(fields: [courseID], references: [id])

  @@unique([projectID, courseID])
  @@map("project_courses")
}
