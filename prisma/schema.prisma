// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "windows", "darwin"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id             Int             @id @default(autoincrement()) @map("id")
  name           String          @unique @map("name")
  userRoles      UserRole[]
  projectMembers ProjectMember[]

  @@map("roles")
}

model UserRole {
  id        Int       @id @default(autoincrement()) @map("id")
  createdBy Int       @map("created_by")
  roleID    Int       @map("role_id")
  updatedBy Int       @map("updated_by")
  userID    Int       @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  role      Role      @relation(fields: [roleID], references: [id])
  user      User      @relation(fields: [userID], references: [id])

  @@unique([userID, roleID])
  @@map("user_roles")
}

model User {
  id            Int       @id @default(autoincrement()) @map("id")
  email         String    @unique @map("email")
  prefixID      Int?      @map("prefix_id")
  emailVerified Boolean   @default(false) @map("email_verified")
  firstNameEn   String?   @map("first_name_en")
  firstNameTh   String    @map("first_name_th")
  imageUrl      String?   @map("image_url")
  imageFocalPointX Float? @map("image_focal_point_x")
  imageFocalPointY Float? @map("image_focal_point_y")
  lastNameEn    String?   @map("last_name_en")
  lastNameTh    String    @map("last_name_th")
  nickName      String?   @map("nick_name")
  createdBy     Int       @map("created_by")
  updatedBy     Int?      @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  prefix         Prefix?     @relation(fields: [prefixID], references: [id])
  userRoles      UserRole[]
  student        Student?
  professor      Professor?
  projectMembers ProjectMember[]
  sessions       Session[]
  accounts       Account[]

  @@map("users")
}

// Better Auth keeps credentials, sessions and verification tokens separate
// from the application's existing user profile and role tables.
model Session {
  id        Int       @id @default(autoincrement()) @map("id")
  userID    Int       @map("user_id")
  token     String    @unique @map("token")
  expiresAt DateTime  @map("expires_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("auth_sessions")
}

model Account {
  id                    Int       @id @default(autoincrement()) @map("id")
  userID                Int       @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?   @map("scope")
  idToken               String?   @map("id_token")
  password              String?   @map("password")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userID])
  @@map("auth_accounts")
}

model Verification {
  id         Int      @id @default(autoincrement()) @map("id")
  identifier String   @map("identifier")
  value      String   @map("value")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}

model TageGroups {
  id   Int    @id @default(autoincrement()) @map("id")
  name String @unique @map("name")
  tags Tag[]

  @@map("tag_groups")
}

model Tag {
  id           Int            @id @default(autoincrement()) @map("id")
  name         String         @unique @map("name")
  tageGroups   TageGroups?    @relation(fields: [tageGroupsId], references: [id])
  tageGroupsId Int            @map("tage_groups_id")
  news         News[]
  newsFeatures NewsFeatures[]
  projectTags  ProjectTag[]

  @@map("tags")
}

model News {
  id           Int            @id @default(autoincrement()) @map("id")
  title        String         @map("title")
  thumbnail    String?        @map("thumbnail")
  thumbnailFocalPointX Float? @map("thumbnail_focal_point_x")
  thumbnailFocalPointY Float? @map("thumbnail_focal_point_y")
  detail       String         @map("detail")
  startDate    DateTime       @map("start_date")
  dueDate      DateTime?      @map("due_date")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")
  createdBy    Int            @map("created_by")
  updatedBy    Int            @map("updated_by")
  tagID        Int            @map("tag_id")
  tag          Tag            @relation(fields: [tagID], references: [id])
  newsFeatures NewsFeatures[]
  newsAdditionalImages NewsAdditionalImage[]

  @@map("news")
}

model NewsAdditionalImage {
  id            Int       @id @default(autoincrement()) @map("id")
  newsID        Int       @map("news_id")
  imageUrl      String    @map("image_url")
  createdBy     Int       @map("created_by")
  updatedBy     Int       @map("updated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  news          News      @relation(fields: [newsID], references: [id])

  @@map("news_additional_images")
}

model Student {
  id          Int       @id @default(autoincrement()) @map("id")
  classBookID Int       @map("classbook_id")
  userID      Int       @unique @map("user_id")
  studentCode String    @map("student_code")
  linkedin    String?   @map("linkedin")
  facebook    String?   @map("facebook")
  instagram   String?   @map("instagram")
  github      String?   @map("github")
  skills      String?   @map("skills")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   Int       @map("created_by")
  updatedBy   Int       @map("updated_by")
  user        User      @relation(fields: [userID], references: [id])
  classBook   ClassBook @relation(fields: [classBookID], references: [id])

  @@map("students")
}

model Curriculum {
  id           Int         @id @default(autoincrement()) @map("id")
  title        String      @map("title")
  year         String      @map("year")
  documentURL  String      @map("document_url")
  description  String      @map("description")
  thumbnailURL String      @map("thumbnail_url")
  thumbnailFocalPointX Float? @map("thumbnail_focal_point_x")
  thumbnailFocalPointY Float? @map("thumbnail_focal_point_y")
  createdBy    Int         @map("created_by")
  updatedBy    Int         @map("updated_by")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")
  courses      Course[]
  classBooks   ClassBook[]

  @@map("curriculums")
}

model Professor {
  id                 Int       @id @default(autoincrement()) @map("id")
  userID             Int       @unique @map("user_id")
  profRoom           String    @map("prof_room")
  phone              String    @map("phone")
  expertFields       String?   @map("expert_fields")
  educations         String?   @map("educations")
  createdBy          Int       @map("created_by")
  updatedBy          Int       @map("updated_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userID], references: [id])

  @@map("professors")
}

model TypeCourse {
  id          Int      @id @default(autoincrement()) @map("id")
  type        String   @unique @map("name")
  description String   @map("description")
  courses     Course[]

  @@map("type_courses")
}

model Course {
  id           Int        @id @default(autoincrement()) @map("id")
  courseCode   String     @map("course_code")
  detail       String     @map("detail")
  courseNameEn String     @map("course_name_en")
  courseNameTh String     @map("course_name_th")
  credits      String     @map("credits")
  typeCourseID Int        @map("type_course_id")
  curriculumID Int        @map("curriculum_id")
  createdBy    Int        @map("created_by")
  updatedBy    Int        @map("updated_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  deletedAt    DateTime?  @map("deleted_at")  
  updatedAt    DateTime   @updatedAt @map("updated_at")
  typeCourse   TypeCourse @relation(fields: [typeCourseID], references: [id])
  curriculum   Curriculum @relation(fields: [curriculumID], references: [id])
  preCourses PreCourse[] 
  prerequisiteOf   PreCourse[] @relation("prerequisiteOf")
  projectCourses ProjectCourse[]

  @@map("courses")
}

model PreCourse {
  id          Int      @id @default(autoincrement())
  courseID    Int      @map("course_id")
  preCourseID Int      @map("pre_course_id")
  createdBy   Int      @map("created_by")
  updatedBy   Int      @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course    Course @relation(fields: [courseID], references: [id])
  prerequisite Course @relation("prerequisiteOf", fields: [preCourseID], references: [id])

  @@unique([courseID, preCourseID])

  @@map("pre_courses")
}


model ClassBook {
  id                Int        @id @default(autoincrement()) @map("id")
  classof           String     @unique @map("classof")
  firstYearAcademic String     @map("first_year_academic")
  thumbnailURL      String     @map("thumbnail_url")
  imageFocalPointX  Float?     @map("image_focal_point_x")
  imageFocalPointY  Float?     @map("image_focal_point_y")
  curriculumID      Int        @map("curriculum_id")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")
  createdBy         Int        @map("created_by")
  updatedBy         Int        @map("updated_by")
  curriculum        Curriculum @relation(fields: [curriculumID], references: [id])
  students          Student[]

  @@map("class_books")
}

